{
  "name": "dsh-subagent-antigravity",
  "description": "One-shot Antigravity (agy CLI) subagent provider over print/stream-json",
  "version": "0.2.1-rc.5",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "scripts": {
    "test": "node --test"
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "icon.svg",
    "README.md",
    "locale/*.json",
    "lib/*.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.5",
    "@deepseek-ai/dsh-session": "0.2.1-rc.5",
    "@deepseek-ai/dsh-subagent": "0.2.1-rc.5",
    "@deepseek-ai/dsh-subprocess": "0.2.1-rc.5",
    "@deepseek-ai/dsh-timeout": "0.2.1-rc.5"
  },
  "dependencies": {
    "@deepseek-ai/dsh-brand": "0.2.1-rc.5",
    "@deepseek-ai/schemastery": "~3.18.5"
  }
}
